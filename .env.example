# --- Agente (elige uno) ---
# Por defecto usa Claude Code instalado en este equipo (sin API key).
# Si prefieres la API de Claude, pon tu clave aquí:
# ANTHROPIC_API_KEY=sk-ant-...
# Modelo (por defecto claude-opus-5-5). Para respuestas más rápidas: claude-sonnet-5-5
# LLM_MODEL=claude-opus-5-5

# --- Voces ---
# Hilos de CPU para la síntesis
# TTS_THREADS=4
# Servidor TTS externo compatible con OpenAI (/v1/audio/speech), p. ej. Chatterbox o IndexTTS en una PC con GPU
# TTS_REMOTE_URL=http://localhost:8004/v1/audio/speech
# TTS_REMOTE_VOICES=Emily,Gabriel
# TTS_REMOTE_LANG=es
# TTS_REMOTE_NAME=Chatterbox

# API_PORT=3210
